{
    "name": "videoeditor",
    "version": "0.1.0",
    "description": "Local-first video editing engine: deterministic ffmpeg timelines, render, and a token-gated review studio. No cloud services.",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "bin": {
        "videoeditor": "./dist/bin/videoeditor.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "ARCHITECTURE.md",
        "NOTICE.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsx src/bin/videoeditor.ts",
        "start": "node dist/bin/videoeditor.js",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "video",
        "ffmpeg",
        "editing",
        "timeline",
        "local-first",
        "agent-skill"
    ],
    "devDependencies": {
        "@types/node": "^22.10.5",
        "tsup": "^8.3.5",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "vitest": "^3.2.4"
    }
}
