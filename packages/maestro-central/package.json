{
    "name": "@gti-skills/maestro-central",
    "version": "0.1.0",
    "private": true,
    "description": "Local real-time dashboard for Maestro runs: live fleet view, task map, and run feed from the ledger in ~/.gti/maestro.",
    "repository": {
        "type": "git",
        "url": "https://github.com/gtihq/ai-skills.git"
    },
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "bin": {
        "maestro-central": "./central/bin/central.mjs"
    },
    "scripts": {
        "start": "node central/bin/central.mjs start --open",
        "serve": "node central/bin/central.mjs serve",
        "demo": "node central/bin/central.mjs demo --open",
        "test": "node --test \"tests/*.test.mjs\""
    }
}
